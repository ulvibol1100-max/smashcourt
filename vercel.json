{
  "version": 2,
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" },
    { "src": "apps/web/**/*", "use": "@vercel/static-build", "config": { "distDir": "apps/web/dist" } }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/apps/web/$1" }
  ]
}
