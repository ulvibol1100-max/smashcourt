{
  "name": "smashcourt",
  "version": "1.0.0",
  "private": true,
  "description": "SmashCourt — Badminton Racket E-Commerce Platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@smashcourt/web",
    "dev:api": "npm run dev --workspace=@smashcourt/api",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace=@smashcourt/api",
    "db:seed": "npm run db:seed --workspace=@smashcourt/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
